<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:key="xiaomi_scooter_battery_info"
        android:title="@string/category_info"
        app:iconSpaceReserved="false">

        <EditTextPreference
            android:defaultValue="@string/unknown"
            android:enabled="false"
            android:key="xiaomi_scooter_voltage"
            android:shouldDisableView="false"
            android:title="@string/xiaomi_scooter_voltage"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:defaultValue="@string/unknown"
            android:enabled="false"
            android:key="xiaomi_scooter_current"
            android:shouldDisableView="false"
            android:title="@string/electrical_current"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:defaultValue="@string/unknown"
            android:enabled="false"
            android:key="xiaomi_scooter_power"
            android:shouldDisableView="false"
            android:title="@string/xiaomi_scooter_power"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:defaultValue="@string/unknown"
            android:enabled="false"
            android:key="xiaomi_scooter_battery_temp"
            android:shouldDisableView="false"
            android:title="@string/xiaomi_scooter_battery_temp"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:defaultValue="@string/unknown"
            android:enabled="false"
            android:key="xiaomi_scooter_battery_cycles"
