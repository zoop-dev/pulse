            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:defaultValue="@string/unknown"
            android:enabled="false"
            android:key="xiaomi_scooter_battery_mfg_date"
            android:shouldDisableView="false"
            android:title="@string/xiaomi_scooter_battery_mfg_date"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:defaultValue="@string/unknown"
            android:enabled="false"
            android:key="xiaomi_scooter_battery_serial"
            android:shouldDisableView="false"
            android:title="@string/xiaomi_scooter_battery_serial"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

        <EditTextPreference
            android:defaultValue="@string/unknown"
            android:enabled="false"
            android:key="xiaomi_scooter_bms_fw_version"
            android:shouldDisableView="false"
            android:title="@string/xiaomi_scooter_bms_fw_version"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
