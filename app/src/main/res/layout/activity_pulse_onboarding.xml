<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pulse_bg">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/onboard_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <nodomain.freeyourgadget.gadgetbridge.activities.welcome.WelcomePageIndicator
        android:id="@+id/onboard_indicator"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        app:page_indicator_color="?attr/pulseAccent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/onboard_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:text="@string/pulse_onboard_skip"
            android:textColor="@color/pulse_text_dim"
            android:textAllCaps="false"
            android:fontFamily="@font/plusjakarta_medium"
            android:textSize="14sp"
            android:stateListAnimator="@null" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/onboard_next"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="120dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:background="@drawable/pulse_pill_primary"
            android:text="@string/pulse_onboard_next"
            android:textColor="@color/pulse_bg"
            android:textAllCaps="false"
            android:fontFamily="@font/plusjakarta_bold"
            android:textSize="15sp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
