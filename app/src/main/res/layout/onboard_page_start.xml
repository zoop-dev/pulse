<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pulse_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="80dp"
            android:src="@drawable/ic_notification"
            app:tint="?attr/pulseAccent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pulse_onboard_start_title"
            android:fontFamily="@font/unbounded"
            android:textColor="@color/pulse_text"
            android:textSize="30sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/pulse_onboard_tagline"
            android:textColor="@color/pulse_text_dim"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.2" />

        <Button
            android:id="@+id/onboard_connect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/pulse_pill_primary"
            android:text="@string/pulse_onboard_connect"
            android:textColor="@color/pulse_bg"
            android:textAllCaps="false"
            android:fontFamily="@font/plusjakarta_bold"
            android:textSize="15sp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/onboard_restore"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/pulse_pill"
            android:backgroundTint="@null"
            android:text="@string/pulse_onboard_restore"
            android:textColor="@color/pulse_text"
            android:textAllCaps="false"
            android:fontFamily="@font/plusjakarta_medium"
            android:textSize="15sp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</ScrollView>
