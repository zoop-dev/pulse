<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pulse_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="72dp"
            android:src="@drawable/ic_shield"
            app:tint="?attr/pulseAccent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pulse_onboard_permissions_title"
            android:fontFamily="@font/unbounded"
            android:textColor="@color/pulse_text"
            android:textSize="26sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/pulse_onboard_permissions_body"
            android:textColor="@color/pulse_text_dim"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.25" />

        <Button
            android:id="@+id/onboard_permissions_review"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/pulse_pill"
            android:backgroundTint="@null"
            android:text="@string/pulse_onboard_permissions_review"
            android:textColor="@color/pulse_text"
            android:textAllCaps="false"
            android:fontFamily="@font/plusjakarta_medium"
            android:textSize="15sp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</ScrollView>
