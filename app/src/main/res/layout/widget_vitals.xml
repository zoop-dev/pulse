<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vitals_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pulse_widget_bg_light"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vitals"
            android:fontFamily="@font/spacegrotesk_bold"
            android:textColor="#16181D"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/vitals_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/activity_summary_today"
            android:fontFamily="@font/plusjakarta_medium"
            android:textColor="#6B6F78"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/vitals_refresh"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_ms_sync"
            android:contentDescription="@string/icon_placeholder" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <ImageView
            android:id="@+id/vitals_head_chip"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/icon_placeholder" />

        <TextView
            android:id="@+id/vitals_head_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/spacegrotesk_semibold"
            android:textColor="#6B6F78"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/vitals_head_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/unbounded"
            android:textColor="#16181D"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/vitals_head_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/spacegrotesk_semibold"
            android:textColor="#6B6F78"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/vitals_head_spark"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:scaleType="fitXY"
        android:contentDescription="@string/icon_placeholder" />

    <TextView
        android:id="@+id/vitals_head_delta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/spacegrotesk_semibold"
        android:textColor="#6B6F78"
        android:textSize="10sp" />

    <ImageView
        android:contentDescription="@string/icon_placeholder"
        android:id="@+id/vitals_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="13dp"
        android:background="#E4E7EC" />

    <LinearLayout
        android:id="@+id/vitals_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/vitals_r0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/vitals_r0_chip"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/icon_placeholder" />

            <TextView
                android:id="@+id/vitals_r0_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/plusjakarta_medium"
                android:textColor="#16181D"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/vitals_r0_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/spacegrotesk_semibold"
                android:textColor="#16181D"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/vitals_r1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/vitals_r1_chip"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/icon_placeholder" />

            <TextView
                android:id="@+id/vitals_r1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/plusjakarta_medium"
                android:textColor="#16181D"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/vitals_r1_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/spacegrotesk_semibold"
                android:textColor="#16181D"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/vitals_r2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/vitals_r2_chip"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/icon_placeholder" />

            <TextView
                android:id="@+id/vitals_r2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/plusjakarta_medium"
                android:textColor="#16181D"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/vitals_r2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/spacegrotesk_semibold"
                android:textColor="#16181D"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
