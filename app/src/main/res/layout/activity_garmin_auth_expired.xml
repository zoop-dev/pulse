<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/oauth_expired_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/garmin_auth_expired_activity_description" />

    <Button
        android:id="@+id/button_goto_authentication_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/authentication_settings" />

    <Button
        android:id="@+id/button_dont_show_again"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/dont_show_again" />

</LinearLayout>
