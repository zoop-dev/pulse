<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/strip_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pulse_widget_bg_dark"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/strip_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/strip_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="PULSE"
            android:fontFamily="@font/spacegrotesk_bold"
            android:letterSpacing="0.14"
            android:textColor="#1488D6"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/strip_device"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/plusjakarta_medium"
            android:textColor="#8A8A93"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/strip_sync_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@string/icon_placeholder"
            android:background="@drawable/pulse_widget_dot_dark" />

        <TextView
            android:id="@+id/strip_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/spacegrotesk_semibold"
            android:textColor="#8A8A93"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/strip_refresh"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_ms_sync"
            android:contentDescription="@string/icon_placeholder" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/strip_slots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/strip_s0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/strip_s0_chip"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/icon_placeholder" />

            <TextView
                android:id="@+id/strip_s0_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/spacegrotesk_bold"
                android:textColor="#ECEBE6"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/strip_s0_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:letterSpacing="0.09"
                android:fontFamily="@font/spacegrotesk_semibold"
                android:textColor="#8A8A93"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/strip_s0_bar"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="7dp"
                android:scaleType="fitXY"
                android:contentDescription="@string/icon_placeholder" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/strip_s1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/strip_s1_chip"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/icon_placeholder" />

            <TextView
                android:id="@+id/strip_s1_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/spacegrotesk_bold"
                android:textColor="#ECEBE6"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/strip_s1_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:letterSpacing="0.09"
                android:fontFamily="@font/spacegrotesk_semibold"
                android:textColor="#8A8A93"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/strip_s1_bar"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="7dp"
                android:scaleType="fitXY"
                android:contentDescription="@string/icon_placeholder" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/strip_s2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/strip_s2_chip"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/icon_placeholder" />

            <TextView
                android:id="@+id/strip_s2_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/spacegrotesk_bold"
                android:textColor="#ECEBE6"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/strip_s2_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:letterSpacing="0.09"
                android:fontFamily="@font/spacegrotesk_semibold"
                android:textColor="#8A8A93"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/strip_s2_bar"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="7dp"
                android:scaleType="fitXY"
                android:contentDescription="@string/icon_placeholder" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/strip_s3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/strip_s3_chip"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/icon_placeholder" />

            <TextView
                android:id="@+id/strip_s3_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/spacegrotesk_bold"
                android:textColor="#ECEBE6"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/strip_s3_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:letterSpacing="0.09"
                android:fontFamily="@font/spacegrotesk_semibold"
                android:textColor="#8A8A93"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/strip_s3_bar"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="7dp"
                android:scaleType="fitXY"
                android:contentDescription="@string/icon_placeholder" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
