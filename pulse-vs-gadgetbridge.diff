 <?xml version="1.0" encoding="utf-8"?>
+<!-- Pulse changelog. Newest release on top. -->
 <changelog>
+    <release version="0.99.1" versioncode="259">
+        <change>Fixed the Today tiles cutting off their values at larger system font sizes</change>
+        <change>Restored Settings &#8250; Health Connect, for sharing your health data with other apps</change>
+        <change>Fixed Max Speed and pace showing impossible values on part-synced workouts</change>
+    </release>
+    <release version="0.99.0" versioncode="258">
+        <change>New: Settings &#8250; Advanced &#8250; Send debug logs &#8212; bundle your recent logs and send them to the developer to help track down a bug</change>
+        <change>The crash notification can now send a full debug report in one tap</change>
+        <change>Fixed the Sleep tab showing the same night when you change day</change>
+        <change>Fixed Your Week hanging on large histories</change>
+        <change>Weather no longer overwrites Breezy Weather data</change>
+        <change>Backups now save as a .zip file</change>
+        <change>About screen and notifications rebranded to Pulse</change>
+        <change>Translations for 20 languages</change>
+        <change>Synced the latest upstream Gadgetbridge changes</change>
+    </release>
     <release version="0.93.0" versioncode="252">
       <change>Initial support for AK75 Pro, AK86, AK102 (TopStep / FitCloud)</change>
       <change>Initial support for DM58 (GloryFit Pro)</change>
@@ -184,1393 +201,79 @@
         <change>OpenTracks integration: Remove unsupported elevation field</change>
         <change>Xiaomi-protobuf: Fix GPS dropping mid-workout on newer firmware</change>
     </release>
-    <release version="0.91.0" versioncode="247">
-        <change>Initial support for Braun iCheck 7 BPW4500 blood pressure monitor</change>
-        <change>Initial support for CMF Buds 2a, Buds 2 Plus</change>
