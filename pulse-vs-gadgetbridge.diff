index 000000000..d2deceac3
--- /dev/null
+++ b/app/src/main/res/layout/activity_pulse_report.xml
@@ -0,0 +1,123 @@
+<?xml version="1.0" encoding="utf-8"?>
+<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@color/pulse_bg"
+    android:fillViewport="true">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:orientation="vertical"
+        android:padding="24dp">
+
+        <TextView
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:text="@string/pulse_report_title"
+            android:fontFamily="@font/unbounded"
+            android:textColor="@color/pulse_text"
+            android:textSize="26sp" />
+
+        <TextView
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="12dp"
+            android:text="@string/pulse_report_intro"
+            android:textColor="@color/pulse_text"
+            android:textSize="15sp"
+            android:lineSpacingMultiplier="1.2" />
+
+        <TextView
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="12dp"
+            android:text="@string/pulse_report_includes"
+            android:textColor="@color/pulse_text_dim"
+            android:textSize="13sp"
+            android:lineSpacingMultiplier="1.25" />
+
+        <TextView
+            android:id="@+id/report_crash_banner"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="16dp"
+            android:padding="12dp"
+            android:background="@drawable/pulse_widget_bg"
+            android:text="@string/pulse_report_crash_banner"
+            android:textColor="@color/pulse_text"
+            android:textSize="13sp"
+            android:visibility="gone" />
+
+        <com.google.android.material.textfield.TextInputLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="20dp"
+            android:hint="@string/pulse_report_note_hint">
+
+            <com.google.android.material.textfield.TextInputEditText
+                android:id="@+id/report_note"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:inputType="textMultiLine|textCapSentences"
+                android:minLines="3"
+                android:gravity="top"
+                android:textColor="@color/pulse_text" />
+
+        </com.google.android.material.textfield.TextInputLayout>
+
+        <TextView
+            android:id="@+id/report_logging_hint"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="8dp"
+            android:text="@string/pulse_report_logging_off"
+            android:textColor="@color/pulse_text_dim"
+            android:textSize="13sp"
+            android:lineSpacingMultiplier="1.2"
+            android:visibility="gone" />
+
+        <com.google.android.material.button.MaterialButton
+            android:id="@+id/report_enable_logging"
+            style="@style/Widget.Material3.Button.TonalButton"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="10dp"
+            android:text="@string/pulse_report_enable_logging"
+            android:visibility="gone" />
+
+        <com.google.android.material.materialswitch.MaterialSwitch
+            android:id="@+id/report_include_fit"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="20dp"
+            android:text="@string/pulse_report_include_fit"
+            android:textColor="@color/pulse_text"
+            android:textSize="15sp"
+            android:visibility="gone" />
+
+        <TextView
+            android:id="@+id/report_include_fit_hint"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="6dp"
+            android:text="@string/pulse_report_include_fit_hint"
+            android:textColor="@color/pulse_text_dim"
+            android:textSize="13sp"
+            android:lineSpacingMultiplier="1.2"
+            android:visibility="gone" />
+
+        <com.google.android.material.button.MaterialButton
+            android:id="@+id/report_send"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="24dp"
+            android:paddingTop="14dp"
+            android:paddingBottom="14dp"
+            android:text="@string/pulse_report_send"
+            android:textSize="15sp" />
+
+    </LinearLayout>
+
+</ScrollView>
diff --git a/app/src/main/res/layout/activity_pulse_sleep.xml b/app/src/main/res/layout/activity_pulse_sleep.xml
new file mode 100644
index 000000000..6dd0501ca
--- /dev/null
+++ b/app/src/main/res/layout/activity_pulse_sleep.xml
@@ -0,0 +1,172 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Pulse: sleep insights — score, last-night stage breakdown, 7-night trend.
+     Stage bar / legend / week bars are built in code. -->
+<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@color/pulse_bg"
+    android:fillViewport="true">
+
+    <LinearLayout
+        android:id="@+id/sleep_root"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:orientation="vertical"
+        android:padding="20dp">
+
+        <TextView
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:text="@string/pulse_sleep_title"
+            android:fontFamily="@font/unbounded"
+            android:textColor="@color/pulse_text"
+            android:textSize="30sp"
+            android:layout_marginBottom="8dp" />
+
+        <TextView
+            android:id="@+id/sleep_empty"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="60dp"
+            android:gravity="center"
+            android:text="@string/pulse_sleep_no_data"
+            android:textColor="@color/pulse_text_dim"
+            android:textSize="15sp"
+            android:visibility="gone" />
+
+        <!-- score -->
+        <LinearLayout
+            android:id="@+id/sleep_score_block"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="vertical"
+            android:layout_marginTop="12dp"
+            android:layout_marginBottom="8dp">
+            <TextView
+                android:id="@+id/sleep_score"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:fontFamily="@font/unbounded"
+                android:textColor="?attr/pulseAccent"
+                android:textSize="64sp" />
+            <LinearLayout
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:orientation="horizontal"
+                android:gravity="center_vertical">
+                <TextView
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:text="@string/pulse_sleep_score"
+                    android:textColor="@color/pulse_text_dim"
+                    android:textSize="15sp" />
+                <TextView
+                    android:id="@+id/sleep_score_word"
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:layout_marginStart="10dp"
+                    android:fontFamily="@font/unbounded"
+                    android:textColor="@color/pulse_mint"
+                    android:textSize="15sp" />
+            </LinearLayout>
+        </LinearLayout>
+
+        <!-- last night -->
+        <LinearLayout
+            android:id="@+id/sleep_lastnight_card"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="vertical"
+            android:background="@drawable/pulse_widget_bg"
+            android:padding="20dp"
+            android:layout_marginTop="12dp">
+            <TextView
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:text="@string/pulse_sleep_last_night"
+                android:textAllCaps="true"
+                android:textColor="?attr/pulseAccent"
+                android:textSize="12sp"
+                android:letterSpacing="0.08"
+                android:textStyle="bold" />
+            <TextView
+                android:id="@+id/sleep_duration"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:layout_marginTop="6dp"
+                android:fontFamily="@font/unbounded"
+                android:textColor="@color/pulse_text"
+                android:textSize="28sp" />
+            <TextView
+                android:id="@+id/sleep_times"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:textColor="@color/pulse_text_dim"
+                android:textSize="14sp" />
+
+            <!-- hypnogram: the night's stage timeline -->
+            <LinearLayout
+                android:id="@+id/sleep_hypnogram"
+                android:layout_width="match_parent"
+                android:layout_height="38dp"
+                android:layout_marginTop="18dp"
+                android:orientation="horizontal" />
+
+            <!-- stage proportions summary -->
+            <LinearLayout
+                android:id="@+id/sleep_stage_bar"
+                android:layout_width="match_parent"
+                android:layout_height="10dp"
+                android:layout_marginTop="10dp"
+                android:orientation="horizontal" />
+            <LinearLayout
+                android:id="@+id/sleep_stage_legend"
+                android:layout_width="match_parent"
+                android:layout_height="wrap_content"
+                android:orientation="horizontal"
+                android:layout_marginTop="12dp" />
+        </LinearLayout>
+
+        <!-- insight -->
+        <TextView
+            android:id="@+id/sleep_insight"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="16dp"
+            android:textColor="@color/pulse_text"
+            android:textSize="15sp"
+            android:lineSpacingMultiplier="1.15" />
+
+        <!-- 7-night trend -->
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="horizontal"
+            android:gravity="center_vertical"
+            android:layout_marginTop="32dp"
+            android:layout_marginBottom="12dp">
+            <TextView
+                android:layout_width="0dp"
+                android:layout_height="wrap_content"
+                android:layout_weight="1"
+                android:text="@string/pulse_sleep_7night"
+                android:textAllCaps="true"
+                android:textColor="?attr/pulseAccent"
+                android:textSize="12sp"
+                android:letterSpacing="0.08"
+                android:textStyle="bold" />
+            <TextView
+                android:id="@+id/sleep_avg"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:textColor="@color/pulse_text_dim"
+                android:textSize="13sp" />
+        </LinearLayout>
+        <LinearLayout
+            android:id="@+id/sleep_week_bars"
+            android:layout_width="match_parent"
+            android:layout_height="140dp"
+            android:orientation="horizontal"
+            android:gravity="bottom" />
+    </LinearLayout>
+</ScrollView>
diff --git a/app/src/main/res/layout/activity_pulse_streak.xml b/app/src/main/res/layout/activity_pulse_streak.xml
new file mode 100644
index 000000000..5109cf8f1
--- /dev/null
+++ b/app/src/main/res/layout/activity_pulse_streak.xml
@@ -0,0 +1,308 @@
+<?xml version="1.0" encoding="utf-8"?>
+<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:background="@color/pulse_bg"
+    android:fillViewport="true">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:orientation="vertical"
+        android:padding="20dp">
+
+        <!-- Streak headline -->
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="horizontal"
+            android:gravity="center_vertical"
+            android:layout_marginTop="8dp"
+            android:layout_marginBottom="4dp">
+
+            <TextView
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:text="🔥"
+                android:textSize="40sp"
+                android:layout_marginEnd="12dp" />
+
+            <LinearLayout
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:orientation="vertical">
+
+                <TextView
+                    android:id="@+id/streak_count"
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:text="0"
+                    android:fontFamily="@font/unbounded"
+                    android:textColor="?attr/pulseAccent"
+                    android:textSize="40sp"
+                    android:includeFontPadding="false" />
+
+                <TextView
+                    android:id="@+id/streak_subtitle"
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:text="@string/pulse_streak_days"
+                    android:textColor="@color/pulse_text_dim"
+                    android:textSize="14sp" />
+            </LinearLayout>
+        </LinearLayout>
+
+        <!-- Goal metric selector -->
+        <LinearLayout
+            android:id="@+id/streak_metric_row"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="horizontal"
+            android:gravity="center_vertical"
+            android:background="@drawable/pulse_widget_bg"
+            android:padding="16dp"
+            android:layout_marginTop="16dp"
+            android:layout_marginBottom="20dp"
+            android:clickable="true"
+            android:focusable="true">
+
+            <TextView
+                android:layout_width="0dp"
+                android:layout_height="wrap_content"
+                android:layout_weight="1"
+                android:text="@string/pulse_streak_goal_label"
+                android:textColor="@color/pulse_text_dim"
+                android:textSize="14sp" />
+
+            <TextView
+                android:id="@+id/streak_metric_value"
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:textColor="@color/pulse_neon_cyan"
+                android:textStyle="bold"
+                android:textSize="15sp" />
+        </LinearLayout>
+
+        <!-- Month navigation -->
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="horizontal"
+            android:gravity="center_vertical"
+            android:layout_marginBottom="14dp">
+
+            <TextView
+                android:id="@+id/streak_prev"
+                android:layout_width="44dp"
+                android:layout_height="44dp"
+                android:gravity="center"
+                android:text="‹"
+                android:textColor="?attr/pulseAccent"
+                android:textSize="26sp"
+                android:clickable="true"
+                android:focusable="true" />
+
+            <TextView
+                android:id="@+id/streak_month"
+                android:layout_width="0dp"
+                android:layout_height="wrap_content"
+                android:layout_weight="1"
+                android:gravity="center"
+                android:fontFamily="@font/unbounded"
+                android:textColor="@color/pulse_text"
+                android:textSize="17sp" />
+
+            <TextView
+                android:id="@+id/streak_next"
+                android:layout_width="44dp"
+                android:layout_height="44dp"
+                android:gravity="center"
+                android:text="›"
+                android:textColor="?attr/pulseAccent"
+                android:textSize="26sp"
+                android:clickable="true"
+                android:focusable="true" />
+        </LinearLayout>
+
+        <!-- Weekday header -->
+        <LinearLayout
+            android:id="@+id/streak_weekdays"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="horizontal"
+            android:layout_marginBottom="4dp" />
+
+        <!-- Calendar grid (built in code) -->
+        <GridLayout
+            android:id="@+id/streak_grid"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:columnCount="7" />
+
+        <!-- Legend -->
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="horizontal"
+            android:gravity="center"
+            android:layout_marginTop="24dp">
+
+            <View
+                android:layout_width="14dp"
+                android:layout_height="14dp"
+                android:background="@drawable/pulse_streak_hit"
+                android:layout_marginEnd="6dp" />
+
+            <TextView
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:text="@string/pulse_streak_legend_hit"
+                android:textColor="@color/pulse_text_dim"
+                android:textSize="13sp"
+                android:layout_marginEnd="20dp" />
+
+            <View
+                android:layout_width="14dp"
+                android:layout_height="14dp"
+                android:background="@drawable/pulse_streak_today"
+                android:layout_marginEnd="6dp" />
+
+            <TextView
+                android:layout_width="wrap_content"
+                android:layout_height="wrap_content"
+                android:text="@string/pulse_streak_legend_today"
+                android:textColor="@color/pulse_text_dim"
+                android:textSize="13sp" />
+        </LinearLayout>
+
+        <!-- Lifetime totals -->
+        <TextView
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:text="@string/pulse_lifetime"
+            android:textAllCaps="true"
+            android:textColor="?attr/pulseAccent"
+            android:textSize="12sp"
+            android:letterSpacing="0.08"
+            android:textStyle="bold"
+            android:layout_marginTop="32dp"
+            android:layout_marginBottom="4dp" />
+
+        <TextView
+            android:id="@+id/life_days"
+            android:layout_width="wrap_content"
+            android:layout_height="wrap_content"
+            android:textColor="@color/pulse_text_dim"
+            android:textSize="13sp"
+            android:layout_marginBottom="14dp" />
+
+        <GridLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:columnCount="2">
+
+            <LinearLayout
+                style="@style/GridTile"
+                android:background="@drawable/pulse_widget_bg"
+                android:layout_margin="6dp"
+                android:gravity="start|center_vertical">
+                <TextView
+                    android:id="@+id/life_steps"
