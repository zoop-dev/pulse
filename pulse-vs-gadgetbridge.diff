+            switch (ev.getActionMasked()) {
+                case android.view.MotionEvent.ACTION_DOWN:
+                    view.animate().scaleX(0.96f).scaleY(0.96f).setDuration(120)
+                            .setInterpolator(new android.view.animation.DecelerateInterpolator()).start();
