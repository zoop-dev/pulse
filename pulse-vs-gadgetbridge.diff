+<?xml version="1.0" encoding="utf-8"?>
+<!-- Pulse: daily goals, split into their own screen -->
+<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:app="http://schemas.android.com/apk/res-auto">
+
+    <PreferenceCategory
+        android:key="pref_category_targets"
+        android:title="@string/activity_prefs_goals">
+
+        <EditTextPreference
+            android:icon="@drawable/ic_steps"
+            android:defaultValue="10000"
+            android:inputType="number"
+            android:key="fitness_goal"
+            android:maxLength="5"
+            android:title="@string/miband_prefs_fitness_goal"
+            app:useSimpleSummaryProvider="true" />
+
+        <Preference
+            android:icon="@drawable/ic_airline_seat_flat"
+            android:key="activity_user_sleep_duration_minutes"
+            android:title="@string/pulse_sleep_goal" />
+
+        <EditTextPreference
+            android:icon="@drawable/ic_cardio_load"
+            android:defaultValue="60"
+            android:inputType="number"
+            android:key="activity_user_activetime_minutes"
+            android:maxLength="3"
+            android:title="@string/activity_prefs_activetime_minutes"
+            app:useSimpleSummaryProvider="true" />
+
+        <EditTextPreference
+            android:icon="@drawable/ic_calories"
+            android:defaultValue="350"
+            android:inputType="number"
+            android:key="activity_user_calories_burnt"
+            android:maxLength="4"
+            android:title="@string/activity_prefs_goal_active_calories_burnt"
+            app:useSimpleSummaryProvider="true" />
+
+        <EditTextPreference
+            android:icon="@drawable/ic_activity_exercise"
+            android:defaultValue="30"
+            android:inputType="number"
+            android:key="pulse_intensity_goal"
+            android:maxLength="3"
+            android:title="@string/pulse_intensity_goal_title"
+            app:useSimpleSummaryProvider="true" />
